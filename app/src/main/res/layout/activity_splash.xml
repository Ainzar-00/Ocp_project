<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Guideline to group center elements perfectly, just like your original code -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.42" />

    <!-- 1. Text elements are placed BEFORE the image in XML so they are drawn UNDER it -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="GROUPE OCP"
        android:textColor="@color/ocp_dark_green"
        tools:textColor="#1B5E20"
        android:textSize="32sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.08"
        app:layout_constraintTop_toBottomOf="@id/guideline_center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="ÉVALUATION DES FORMATIONS"
        android:textColor="#2E7D32"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:textAllCaps="true"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Footer separator -->
    <View
        android:id="@+id/footer_separator"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginBottom="24dp"
        android:background="#1B5E20"
        app:layout_constraintBottom_toTopOf="@id/bottom_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/bottom_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="Direction des Ressources Humaines"
        android:textColor="#757575"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. Pure ImageView placed LAST so it naturally sits ON TOP of everything -->
    <!-- Original constraints restored so it sits exactly where you need it! -->
    <ImageView
        android:id="@+id/tv_logo"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:contentDescription="OCP Logo"
        android:scaleType="centerInside"
        android:src="@drawable/ocp"
        app:layout_constraintBottom_toTopOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
