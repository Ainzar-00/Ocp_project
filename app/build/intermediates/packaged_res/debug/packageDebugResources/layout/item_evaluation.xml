<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Thème (Expands fully across the top) -->
        <TextView
            android:id="@+id/tv_item_theme"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="HSE - Sécurité au travail"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#222222"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Matricule -->
        <TextView
            android:id="@+id/tv_item_matricule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Mat: 894521"
            android:textSize="13sp"
            android:textColor="#757575"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tv_item_theme"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Separator Dot -->
        <TextView
            android:id="@+id/tv_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="#BDBDBD"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            app:layout_constraintTop_toTopOf="@id/tv_item_matricule"
            app:layout_constraintBottom_toBottomOf="@id/tv_item_matricule"
            app:layout_constraintStart_toEndOf="@id/tv_item_matricule" />

        <!-- Date aligned cleanly next to Matricule -->
        <TextView
            android:id="@+id/tv_item_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="15 Oct 2026"
            android:textSize="13sp"
            android:textColor="#757575"
            android:layout_marginStart="4dp"
            app:layout_constraintTop_toTopOf="@id/tv_item_matricule"
            app:layout_constraintBottom_toBottomOf="@id/tv_item_matricule"
            app:layout_constraintStart_toEndOf="@id/tv_separator" />

        <!-- Entité Badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/badge_entite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="6dp"
            app:cardBackgroundColor="#F0F4F8"
            app:cardElevation="0dp"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/tv_item_matricule"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tv_item_entite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Direction Technique"
                android:textSize="11sp"
                android:textColor="#455A64"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp" />
        </com.google.android.material.card.MaterialCardView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
