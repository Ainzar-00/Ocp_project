<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="#F8F9FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:layout_marginBottom="80dp"
        android:background="#F8F9FA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="80dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAnalyticsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Analyses des Questions"
                        android:textColor="#212529"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Performances par critère &amp; taux de satisfaction"
                        android:textColor="#6C757D"
                        android:textSize="13sp" />

                </LinearLayout>

                <Spinner
                    android:id="@+id/spinnerYearFilter"
                    android:layout_width="130dp"
                    android:layout_height="40dp"
                    android:background="@android:drawable/btn_dropdown" />

            </LinearLayout>

            <!-- ══════════════════════════════════════════════════════
                 EXPORT SECTION CARD
                 ══════════════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Title row -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Exporter une Synthèse"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#212529"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Choisissez un thème ou exportez tout"
                        android:textSize="12sp"
                        android:textColor="#6C757D"
                        android:layout_marginBottom="12dp"/>

                    <!-- Theme Spinner row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thème :"
                            android:textSize="13sp"
                            android:textColor="#495057"
                            android:layout_marginEnd="10dp"/>

                        <Spinner
                            android:id="@+id/spinnerThemeFilter"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@android:drawable/btn_dropdown"
                            android:paddingStart="8dp"/>

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F0F0F0"
                        android:layout_marginBottom="12dp"/>

                    <!-- ── Default state: NO theme selected ─────────── -->
                    <!-- Single "Exporter" button (global) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fabExport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Exporter Synthèse Globale"
                        android:textColor="@color/ocp_dark_green"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        app:icon="@drawable/excel_vector"
                        app:iconTint="@null"
                        app:iconSize="20dp"
                        app:iconPadding="8dp"
                        app:iconGravity="textStart"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@android:color/white"
                        app:strokeColor="@color/ocp_dark_green"
                        app:strokeWidth="1.5dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:visibility="visible"/>

                    <!-- ── Theme selected: show 3 options ───────────── -->
                    <LinearLayout
                        android:id="@+id/layoutThemeExportOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Option 1 : Synthèse Globale -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportGlobale"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Exporter Synthèse Globale"
                            android:textColor="@color/ocp_dark_green"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            app:icon="@drawable/excel_vector"
                            app:iconTint="@null"
                            app:iconSize="20dp"
                            app:iconPadding="8dp"
                            app:iconGravity="textStart"
                            app:cornerRadius="12dp"
                            app:backgroundTint="@android:color/white"
                            app:strokeColor="@color/ocp_dark_green"
                            app:strokeWidth="1.5dp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                        <!-- Option 2 : Synthèse Tous les Thèmes -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportAllThemes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Exporter Synthèse Tous les Thèmes"
                            android:textColor="#1565C0"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            app:icon="@drawable/excel_vector"
                            app:iconTint="@null"
                            app:iconSize="20dp"
                            app:iconPadding="8dp"
                            app:iconGravity="textStart"
                            app:cornerRadius="12dp"
                            app:backgroundTint="@android:color/white"
                            app:strokeColor="#1565C0"
                            app:strokeWidth="1.5dp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                        <!-- Option 3 : Synthèse du Thème sélectionné -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportOneTheme"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Exporter Synthèse ce Thème"
                            android:textColor="#E65100"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            app:icon="@drawable/excel_vector"
                            app:iconTint="@null"
                            app:iconSize="20dp"
                            app:iconPadding="8dp"
                            app:iconGravity="textStart"
                            app:cornerRadius="12dp"
                            app:backgroundTint="@android:color/white"
                            app:strokeColor="#E65100"
                            app:strokeWidth="1.5dp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Radar Chart Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Performance par Critère"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#212529" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:text="Moyenne sur une échelle de 1 à 4"
                        android:textSize="12sp"
                        android:textColor="#6C757D" />

                    <com.github.mikephil.charting.charts.RadarChart
                        android:id="@+id/radarChart"
                        android:layout_width="match_parent"
                        android:layout_height="380dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Pie Chart Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvPieChartTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Taux de Satisfaction"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#212529" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:text="Distribution des réponses satisfaisantes vs insatisfaisantes"
                        android:textSize="12sp"
                        android:textColor="#6C757D" />

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/pieChart"
                        android:layout_width="match_parent"
                        android:layout_height="280dp" />

                    <!-- Legend -->
                    <LinearLayout
                        android:id="@+id/layoutLegend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="#4CAF50"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/tvLegendSatisfaisant"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Satisfaisant: 0"
                                android:textSize="13sp"
                                android:textColor="#212529" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="#F44336"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/tvLegendInsatisfaisant"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Insatisfaisant: 0"
                                android:textSize="13sp"
                                android:textColor="#212529" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Stats -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvSatisfiedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 réponses"
                            android:textSize="12sp"
                            android:textColor="#6C757D"
                            android:layout_marginEnd="24dp" />

                        <TextView
                            android:id="@+id/tvUnsatisfiedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 réponses"
                            android:textSize="12sp"
                            android:textColor="#6C757D" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>