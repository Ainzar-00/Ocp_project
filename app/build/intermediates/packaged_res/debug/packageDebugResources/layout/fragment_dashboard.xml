<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title row with info icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="350dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tableau de bord"
                android:textColor="@color/ocp_dark_green"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_info"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_info_details"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Informations"
                android:padding="6dp"
                app:tint="@color/ocp_dark_green" />

        </LinearLayout>

        <!-- KPI Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="3"
            android:layout_marginBottom="16dp">

            <!-- Row 1: Taux de couverture (left) -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/ocp_dark_green">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Taux de couverture" android:textSize="11sp" android:textColor="#CCFFFFFF"
                        android:gravity="center" />
                    <TextView android:id="@+id/tv_taux_couverture_pct"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—%" android:textSize="28sp" android:textColor="@android:color/white"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/tv_taux_couverture_ratio"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—/—" android:textSize="12sp" android:textColor="#CCFFFFFF" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Row 1: Thèmes réalisés (right) -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#1565C0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/tv_themes_realises"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="32sp" android:textColor="@android:color/white"
                        android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Thèmes réalisés" android:textSize="12sp" android:textColor="#CCFFFFFF" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Row 2: Évaluations (left) -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#E65100">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/tv_total_evals"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="32sp" android:textColor="@android:color/white"
                        android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Évaluations" android:textSize="12sp" android:textColor="#CCFFFFFF" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Row 2: En attente FLM (right) -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#6A1B9A">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/tv_pending_invitations"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="32sp" android:textColor="@android:color/white"
                        android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="En attente FLM" android:textSize="12sp" android:textColor="#CCFFFFFF" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Row 3: Thème le plus récurrent (left) -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#00695C">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Thème récurrent" android:textSize="11sp" android:textColor="#CCFFFFFF"
                        android:gravity="center" />
                    <TextView android:id="@+id/tv_theme_plus_recent"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="13sp" android:textColor="@android:color/white"
                        android:textStyle="bold" android:gravity="center" android:maxLines="2" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>



            <!-- Row 3: JSP (right) -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#37474F">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <TextView android:id="@+id/tv_jsp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="—" android:textSize="32sp" android:textColor="@android:color/white"
                        android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="JSP" android:textSize="12sp" android:textColor="#CCFFFFFF" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </GridLayout>


    </LinearLayout>

</ScrollView>