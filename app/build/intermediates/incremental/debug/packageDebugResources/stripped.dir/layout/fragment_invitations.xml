<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA"
    android:padding="16dp">

    <!-- Search + Filter row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/etSearchMatricule"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:hint="Rechercher par matricule, nom, thème..."
            android:background="@android:drawable/editbox_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="text"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/btnFilterService"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="#555555"
            android:contentDescription="Filtrer" />
    </LinearLayout>

    <!-- Pending count -->
    <TextView
        android:id="@+id/tvPendingCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 en attente"
        android:textColor="#666666"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <!-- End-of-month banner -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEndOfMonth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#FFF3E0"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvEndOfMonthInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ Fin du mois"
                android:textColor="#E65100"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Envoyer toutes les invitations non expédiées"
                android:backgroundTint="#E65100"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/progressInvitation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔍 Utilisez la recherche ou les filtres pour afficher les invitations.\nEn fin de mois, toutes les invitations non expédiées apparaissent automatiquement."
        android:textColor="#999999"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="visible" />

    <!-- List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInvitations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
